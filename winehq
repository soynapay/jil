1. enable 32-bit archi support
sudo dpkg --add-architecture i386
sudo apt update
2. add winehq repo and key
-download and install winehq gpg key
-add the winehq Trixie source list
sudo mkdir -pm755 /etc/apt/keyrings
wget -O - https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor | sudo tee /etc/apt/keyrings/winehq-archive.key > /dev/null
sudo wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/debian/dists/trixie/winehq-trixie.sources
